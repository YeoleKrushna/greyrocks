---
interface Props { name: string; class?: string; size?: number; }
const { name, class: className = '', size = 18 } = Astro.props;
---
<svg class={`icon ${className}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow-up-right' && <><path d="M7 17 17 7"/><path d="M7 7h10v10"/></>}
  {name === 'arrow-right' && <><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></>}
  {name === 'code' && <><path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/></>}
  {name === 'brain' && <><path d="M9.5 4.2A3.5 3.5 0 0 0 6 7.7v.5A3.5 3.5 0 0 0 3.5 11.5 3.5 3.5 0 0 0 7 15v.3a3.2 3.2 0 0 0 5 2.6 3.2 3.2 0 0 0 5-2.6V15a3.5 3.5 0 0 0 3.5-3.5A3.5 3.5 0 0 0 18 8.2v-.5a3.5 3.5 0 0 0-3.5-3.5A3.5 3.5 0 0 0 12 5.8 3.5 3.5 0 0 0 9.5 4.2Z"/><path d="M12 6v12"/><path d="M8 9h4"/><path d="M12 13h4"/></>}
  {name === 'chart' && <><path d="M4 19V5"/><path d="M4 19h16"/><path d="m7 15 3-4 3 2 5-7"/></>}
  {name === 'database' && <><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5"/><path d="M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"/></>}
  {name === 'cloud' && <><path d="M17.5 19H8a5 5 0 1 1 1.4-9.8A6.1 6.1 0 0 1 21 11.3 4.4 4.4 0 0 1 17.5 19Z"/></>}
  {name === 'workflow' && <><rect x="3" y="4" width="6" height="6" rx="1"/><rect x="15" y="4" width="6" height="6" rx="1"/><rect x="9" y="14" width="6" height="6" rx="1"/><path d="M9 7h6"/><path d="M18 10v2a2 2 0 0 1-2 2H8a2 2 0 0 0-2 2v0"/></>}
  {name === 'menu' && <><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12"/><path d="m18 6-12 12"/></>}
  {name === 'check' && <><path d="m5 12 4 4L19 6"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'pin' && <><path d="M12 21s7-5.1 7-11A7 7 0 0 0 5 10c0 5.9 7 11 7 11Z"/><circle cx="12" cy="10" r="2.3"/></>}
</svg>
