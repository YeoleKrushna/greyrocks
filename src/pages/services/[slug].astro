---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---
<BaseLayout title={service.title} description={service.description} canonical={`https://greyrocks.in/services/${service.slug}`}>
  <section class="page-hero"><div class="container page-hero__grid"><div><div class="eyebrow eyebrow--light">{service.eyebrow}</div><h1>{service.title}</h1></div><div class="page-hero__aside"><p>{service.value}</p></div></div></section>
  <section class="section"><div class="container service-detail__grid"><aside class="service-detail__aside"><div class="aside-card"><div class="eyebrow">CAPABILITIES</div><h3>{service.shortTitle}</h3><ul class="aside-list">{service.capabilities.map(item => <li>{item}</li>)}</ul></div></aside><article class="service-detail__copy"><h2>{service.problem}</h2><p>{service.description}</p><div class="detail-block"><h3>What we solve</h3><div class="bullet-grid">{service.capabilities.map(item => <div class="bullet">{item}</div>)}</div></div><div class="detail-block"><h3>Typical deliverables</h3><div class="bullet-grid">{service.deliverables.map(item => <div class="bullet">{item}</div>)}</div></div><div class="detail-block"><h3>Typical engagement flow</h3><div class="steps">{service.approach.map((step, i) => <div class="step"><div class="step__num">0{i+1}</div><div><div class="step__title">{step}</div><div class="step__body">A focused step in a broader engagement sequence; the exact depth is configured around the work.</div></div></div>)}</div></div><div class="detail-block"><h3>Technology ecosystem</h3><div class="tech-tags">{service.technologies.map(item => <span class="tech-tag">{item}</span>)}</div></div><div class="detail-block"><h3>Frequently asked questions</h3><div class="faqs">{service.faqs.map(faq => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div></div></article></div></section>
  <CTASection />
</BaseLayout>
