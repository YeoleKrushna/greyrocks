---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" description="The requested GreyRocks page could not be found." noindex>
  <div id="not-found-content">
    <section class="page-hero"><div class="container page-hero__grid"><div><div class="eyebrow eyebrow--light">404 • SYSTEM RESPONSE</div><h1>That page doesn’t exist.</h1></div><div class="page-hero__aside"><p>The system could not find the destination you were looking for.</p><div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:24px"><a class="button button--primary" href="/">Back Home <Icon name="arrow-up-right" /></a><a class="button button--outline" href="/services">Explore Services <Icon name="arrow-right" /></a></div></div></div></section>
    <section class="section"><div class="container" style="min-height:30vh;display:grid;place-items:center"><div style="font-size:12px;letter-spacing:.12em;color:var(--color-muted);text-transform:uppercase">GreyRocks / route not resolved</div></div></section>
  </div>

  <div id="certificate-fallback" hidden>
    <section class="page-hero verification-hero">
      <div class="container page-hero__grid">
        <div><div class="eyebrow eyebrow--light">GREYROCKS CREDENTIALS</div><h1>Certificate <span class="display-serif">Verification</span></h1></div>
        <div class="page-hero__aside"><p>Review the verification result for this GreyRocks internship certificate.</p></div>
      </div>
    </section>
    <section class="section verification-section">
      <div class="container verification-container">
        <article id="certificate-result" class="form-shell verification-card" aria-live="polite" aria-busy="true">
          <div class="verification-result-heading">
            <span id="certificate-mark" class="verification-mark" aria-hidden="true">…</span>
            <div><p id="certificate-eyebrow" class="mono-label">CHECKING CREDENTIAL</p><h2 id="certificate-title">Verifying certificate…</h2></div>
          </div>
          <p id="certificate-message" class="lede">We’re checking this certificate against GreyRocks records.</p>
          <dl id="certificate-details" class="certificate-details" hidden></dl>
          <p id="certificate-help" class="verification-help" hidden></p>
          <a class="button button--outline verification-back" href="/verification">Verify another certificate</a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { normalizeId, isValidCertificateId } from '../lib/validation.js';

  const routePrefix = '/verification/';
  const path = window.location.pathname;
  if (path.startsWith(routePrefix)) {
    document.title = 'Certificate Verification | GreyRocks';
    document.querySelector<HTMLElement>('#not-found-content')?.setAttribute('hidden', '');
    document.querySelector<HTMLElement>('#certificate-fallback')?.removeAttribute('hidden');

    const rawId = path.slice(routePrefix.length).split('/')[0] ?? '';
    let id = rawId;
    try { id = decodeURIComponent(rawId); } catch { /* Keep malformed path data as an invalid ID. */ }
    id = normalizeId(id);

    const title = document.querySelector<HTMLElement>('#certificate-title');
    const eyebrow = document.querySelector<HTMLElement>('#certificate-eyebrow');
    const message = document.querySelector<HTMLElement>('#certificate-message');
    const mark = document.querySelector<HTMLElement>('#certificate-mark');
    const details = document.querySelector<HTMLDListElement>('#certificate-details');
    const help = document.querySelector<HTMLElement>('#certificate-help');
    const result = document.querySelector<HTMLElement>('#certificate-result');

    const showState = (state: 'valid' | 'not-found' | 'unavailable', certificate?: { credential_id: string; name: string; domain: string; duration: string }) => {
      if (!title || !eyebrow || !message || !mark || !details || !help || !result) return;
      result.setAttribute('aria-busy', 'false');
      details.replaceChildren();
      help.hidden = true;
      if (state === 'valid' && certificate) {
        eyebrow.textContent = 'AUTHENTIC GREYROCKS CREDENTIAL';
        title.textContent = 'Certificate Verified';
        message.textContent = 'This certificate has been successfully verified as authentic.';
        mark.textContent = '✓';
        for (const [label, value] of [
          ['Certificate ID', certificate.credential_id],
          ['Name', certificate.name],
          ['Internship Domain', certificate.domain],
          ['Duration', certificate.duration],
          ['Status', 'Verified'],
        ]) {
          const row = document.createElement('div');
          row.className = 'certificate-detail';
          const term = document.createElement('dt');
          term.textContent = label;
          const description = document.createElement('dd');
          description.textContent = value;
          row.append(term, description);
          if (label === 'Certificate ID') row.classList.add('certificate-detail--id');
          if (label === 'Status') description.classList.add('status-badge');
          details.append(row);
        }
        details.hidden = false;
        return;
      }
      mark.classList.add('verification-mark--error');
      if (state === 'not-found') {
        eyebrow.textContent = 'NO MATCHING RECORD';
        title.textContent = 'Certificate Not Found';
        message.textContent = 'We could not find a certificate matching this ID.';
        help.textContent = 'Please check the certificate ID and try again.';
      } else {
        eyebrow.textContent = 'VERIFICATION UNAVAILABLE';
        title.textContent = 'Please Try Again';
        message.textContent = 'Verification service temporarily unavailable.';
      }
      mark.textContent = state === 'not-found' ? '×' : '!';
      help.hidden = state !== 'not-found';
    };

    if (!isValidCertificateId(id)) {
      showState('not-found');
    } else {
      const apiBase = (import.meta.env.PUBLIC_VERIFICATION_API_URL || 'https://greyrocks-verification-api.onrender.com').replace(/\/$/, '');
      fetch(`${apiBase}/api/verification/${encodeURIComponent(id)}`, { headers: { Accept: 'application/json' } })
        .then(async (response) => {
          if (response.status === 404) return showState('not-found');
          if (!response.ok) return showState('unavailable');
          const payload = await response.json();
          const certificate = payload?.verified === true ? payload.certificate : null;
          if (!certificate || !['credential_id', 'name', 'domain', 'duration'].every((key) => typeof certificate[key] === 'string')) {
            return showState('unavailable');
          }
          showState('valid', certificate);
        })
        .catch(() => showState('unavailable'));
    }
  }
</script>

<style is:global>
  [hidden] { display: none !important; }
  .verification-hero { padding-bottom: clamp(48px, 6vw, 72px); }
  .verification-hero h1 { max-width: 12ch; }
  .verification-hero h1 span { white-space: nowrap; }
  .verification-section { padding-top: clamp(44px, 6vw, 72px); }
  .verification-container { max-width: 820px; }
  .verification-card { padding: clamp(22px, 5vw, 44px); border-radius: var(--radius-lg); }
  .verification-result-heading { display: flex; align-items: center; gap: 16px; }
  .verification-mark { display: grid; width: 48px; height: 48px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: #276848; background: rgba(58,139,94,.13); font-size: 23px; font-weight: 700; }
  .verification-mark--error { color: #963838; background: rgba(157,41,41,.1); }
  .verification-card h2 { margin-top: 8px; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .verification-card > .lede { margin-top: 22px; }
  .certificate-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 28px 0 0; border: 1px solid var(--color-line); border-radius: 12px; overflow: hidden; }
  .certificate-detail { min-width: 0; padding: 18px 20px; border-bottom: 1px solid var(--color-line); }
  .certificate-detail:nth-child(odd) { border-right: 1px solid var(--color-line); }
  .certificate-detail--id { grid-column: 1 / -1; border-right: 0 !important; background: var(--color-soft); }
  .certificate-detail dt { color: var(--color-muted); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .certificate-detail dd { margin: 6px 0 0; color: var(--color-midnight); font-size: 16px; font-weight: 650; overflow-wrap: anywhere; }
  .verification-help { margin-top: 8px; color: var(--color-muted); }
  .verification-back { margin-top: 26px; }
  @media (max-width: 700px) {
    .verification-hero { padding-top: 90px; }
    .verification-hero h1 span { white-space: normal; }
    .verification-card { padding: 22px 18px; }
    .certificate-details { grid-template-columns: 1fr; }
    .certificate-detail, .certificate-detail:nth-child(odd) { border-right: 0; }
    .certificate-detail--id { grid-column: auto; }
    .verification-back { width: 100%; }
  }
</style>
