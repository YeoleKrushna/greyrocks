---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Certificate Verification"
  description="Verify the authenticity of an internship certificate issued by GreyRocks."
  canonical="https://greyrocks.in/verification"
>
  <section class="page-hero verification-hero">
    <div class="container page-hero__grid">
      <div>
        <div class="eyebrow eyebrow--light">GREYROCKS CREDENTIALS</div>
        <h1>Certificate <span class="display-serif">Verification</span></h1>
      </div>
      <div class="page-hero__aside">
        <p>Verify the authenticity of an internship certificate issued by GreyRocks.</p>
      </div>
    </div>
  </section>

  <section class="section verification-section">
    <div class="container verification-container">
      <div class="form-shell verification-card">
        <div class="verification-card__intro">
          <span class="verification-mark" aria-hidden="true">✓</span>
          <div>
            <p class="mono-label">OFFICIAL CERTIFICATE CHECK</p>
            <h2>Verify a certificate</h2>
          </div>
        </div>
        <p class="lede">Enter the certificate ID exactly as it appears on the document.</p>
        <form id="verifyForm" action="/verification" method="get">
          <div class="form-field">
            <label for="certId">Certificate ID</label>
            <input
              type="text"
              id="certId"
              name="certId"
              placeholder="GR-AI-2026-FC1AC8"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              required
            />
          </div>
          <button class="button button--primary verification-submit" type="submit">
            Verify Certificate <span aria-hidden="true">→</span>
          </button>
        </form>
        <p class="verification-note">Certificate IDs are checked securely against GreyRocks records.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { normalizeId, isValidCertificateId } from '../lib/validation.js';

  const form = document.querySelector<HTMLFormElement>('#verifyForm');
  const input = document.querySelector<HTMLInputElement>('#certId');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const id = normalizeId(input?.value ?? '');
    if (!isValidCertificateId(id)) {
      input?.setCustomValidity('Enter a valid certificate ID, such as GR-AI-2026-FC1AC8.');
      input?.reportValidity();
      return;
    }
    input?.setCustomValidity('');
    window.location.assign(`/verification/${encodeURIComponent(id)}`);
  });
  input?.addEventListener('input', () => input.setCustomValidity(''));
</script>

<style>
  .verification-hero { padding-bottom: clamp(48px, 6vw, 72px); }
  .verification-hero h1 { max-width: 12ch; }
  .verification-hero h1 span { white-space: nowrap; }
  .verification-section { padding-top: clamp(44px, 6vw, 72px); }
  .verification-container { max-width: 820px; }
  .verification-card { padding: clamp(22px, 5vw, 44px); border-radius: var(--radius-lg); }
  .verification-card__intro { display: flex; align-items: center; gap: 16px; }
  .verification-mark { display: grid; width: 48px; height: 48px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: var(--color-midnight); background: rgba(199,156,90,.16); font-size: 23px; }
  .verification-card h2 { margin-top: 8px; font-size: clamp(1.8rem, 4vw, 2.5rem); }
  .verification-card > .lede { margin-top: 22px; }
  .verification-card form { margin-top: 26px; }
  .verification-card input { width: 100%; min-height: 52px; margin-top: 8px; padding: 0 15px; border: 1px solid var(--color-line-strong); border-radius: 9px; color: var(--color-ink); background: var(--color-ivory); letter-spacing: .035em; text-transform: uppercase; }
  .verification-card input::placeholder { color: var(--color-muted); opacity: .8; }
  .verification-submit { margin-top: 18px; background: var(--color-midnight); color: #fff; border-color: var(--color-midnight); }
  .verification-submit:hover { background: var(--color-sapphire); color: #fff; }
  .verification-note { margin-top: 22px; padding-top: 17px; border-top: 1px solid var(--color-line); color: var(--color-muted); font-size: 13px; }
  @media (max-width: 700px) {
    .verification-hero { padding-top: 90px; }
    .verification-hero h1 span { white-space: normal; }
    .verification-card { padding: 22px 18px; }
    .verification-submit { width: 100%; }
  }
</style>
