---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, hasConfiguredFormEndpoint } from '../config/site';
---
<BaseLayout title="Contact GreyRocks" description="Contact GreyRocks about software, AI, data, cloud, backend, automation or consulting work." canonical="https://greyrocks.in/contact">
  <section class="page-hero"><div class="container page-hero__grid"><div><div class="eyebrow eyebrow--light">CONTACT</div><h1>Let’s build something useful.</h1></div><div class="page-hero__aside"><p>Tell us what you’re trying to solve. We’ll help translate it into a practical technology plan.</p></div></div></section>
  <section class="section"><div class="container contact-grid">
    <aside class="contact-side reveal">
      <SectionHeading eyebrow="START A PROJECT" title="Bring the messy version." lede="A useful first message can be rough. Share the context, constraint or system that is giving you trouble." />
      <div class="contact-location"><strong>{siteConfig.headquarters.label}</strong><p>{siteConfig.headquarters.city}, {siteConfig.headquarters.region}, {siteConfig.headquarters.country}</p></div>
      <div class="contact-location"><strong>Office</strong><p>Bengaluru, Karnataka, India</p></div>
      <div class="contact-location"><strong>Email</strong><p><a class="text-link" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail} <Icon name="arrow-up-right" /></a></p></div>
    </aside>
    <div class="form-shell reveal">
      <form data-contact-form data-endpoint={siteConfig.contactFormEndpoint}>
        <div class="form-grid">
          <div class="form-field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="form-field"><label for="email">Work Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div class="form-field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" /></div>
          <div class="form-field"><label for="phone">Phone <span class="form-help">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="form-field"><label for="project-type">Project type</label><select id="project-type" name="projectType"><option>Web Development</option><option>AI / ML</option><option>Data Science</option><option>Backend</option><option>Database</option><option>Cloud / DevOps</option><option>Automation</option><option>Consulting</option><option>Other</option></select></div>
          <div class="form-field"><label for="budget">Budget range</label><select id="budget" name="budget"><option value="">Select</option><option>Under ₹1 lakh</option><option>₹1–5 lakh</option><option>₹5–10 lakh</option><option>₹10 lakh+</option><option>Not decided</option></select></div>
          <div class="form-field"><label for="timeline">Timeline</label><select id="timeline" name="timeline"><option value="">Select</option><option>Exploring</option><option>0–4 weeks</option><option>1–3 months</option><option>3+ months</option></select></div>
          <div class="form-field form-field--full"><label for="build">What are you looking to build?</label><input id="build" name="build" required /></div>
          <div class="form-field form-field--full"><label for="message">Message</label><textarea id="message" name="message" placeholder="What exists today? What needs to change? What would make the project useful?" required></textarea></div>
        </div>
        <div class="form-actions"><span class="form-help">Required fields are marked by browser validation. No data is sent until a real endpoint is configured.</span><button class="button button--primary" type="submit">Send enquiry <Icon name="arrow-up-right" /></button></div>
        <div class="form-status" data-form-status role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </div></section>
</BaseLayout>
